
# 登录是否强制邮箱验证码（默认 1 强制；设为 0 则仅校验账号密码）
# 前端登录表单当前不提供验证码输入项，若 SMTP 已配置会导致登录恒失败，可置 0 临时豁免
# REQUIRE_LOGIN_CODE=1

# Artalk 评论管理对接（列表直读 artalk.db，写操作走 API；本地不配则评论页为空）
# ARTALK_BASE_URL=http://127.0.0.1:23366
# ARTALK_BOT_EMAIL=bot@liqiming.local
# ARTALK_BOT_PASSWORD=
# ARTALK_DB_PATH=/opt/artalk/artalk.db
