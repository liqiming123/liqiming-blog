---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("qq:") || item.url.startsWith("wx:")) {
                        return <button type="button" aria-label={item.name}
                                    data-contact-type={item.url.startsWith("qq:") ? "qq" : "wx"}
                                    data-contact-value={item.url.split(":")[1]}
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </button>
                    } else if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>

  <!-- QQ/微信号码弹窗卡片 -->
  <div id="profile-contact-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.45)" aria-hidden="true">
    <div class="card-base w-72 rounded-2xl p-5 text-center relative active:scale-95 transition-transform">
      <button type="button" id="profile-contact-close" aria-label="关闭" class="absolute right-3 top-2.5 text-xl opacity-50 hover:opacity-100 transition-opacity cursor-pointer">×</button>
      <div id="profile-contact-icons" class="flex justify-center my-1">
        <span data-ci="qq" class="hidden text-(--primary)"><Icon name="simple-icons:tencentqq" class="text-[2.4rem]" /></span>
        <span data-ci="wx" class="hidden text-(--primary)"><Icon name="simple-icons:wechat" class="text-[2.4rem]" /></span>
      </div>
      <p id="profile-contact-label" class="m-0 text-sm opacity-60"></p>
      <p id="profile-contact-value" class="m-0 my-2 text-2xl font-bold tracking-wider select-all"></p>
      <div class="flex gap-2 justify-center mt-3">
        <button type="button" id="profile-contact-copy" class="btn-regular rounded-lg px-4 py-1.5 text-sm font-bold active:scale-95 cursor-pointer">复制号码</button>
        <a id="profile-contact-action" href="#" target="_blank" rel="noopener" class="btn-regular rounded-lg px-4 py-1.5 text-sm font-bold active:scale-95 hidden">发起会话</a>
      </div>
    </div>
  </div>
</div>

<script>
	const modal = document.getElementById("profile-contact-modal");
	if (modal) {
		let currentValue = "";
		document.addEventListener("click", (e) => {
			const trigger = (e.target as HTMLElement).closest("[data-contact-type]");
			if (trigger) {
				e.preventDefault();
				const type = (trigger as HTMLElement).dataset.contactType;
				currentValue = (trigger as HTMLElement).dataset.contactValue || "";
				modal.querySelectorAll("[data-ci]").forEach((el) => {
					el.classList.toggle("hidden", (el as HTMLElement).dataset.ci !== type);
				});
				const label = document.getElementById("profile-contact-label");
				if (label) {
					label.textContent =
						type === "qq" ? "QQ 号（点击号码可选中）" : "微信号（点击号码可选中）";
				}
				const valueEl = document.getElementById("profile-contact-value");
				if (valueEl) {
					valueEl.textContent = currentValue;
				}
				const action = document.getElementById("profile-contact-action");
				if (type === "qq") {
					action?.classList.remove("hidden");
					action?.setAttribute("href", `https://wpa.qq.com/msgrd?v=3&uin=${currentValue}&site=qq&menu=yes`);
				} else {
					action?.classList.add("hidden");
				}
				modal.classList.remove("hidden");
				modal.classList.add("flex");
				modal.setAttribute("aria-hidden", "false");
			}
			if ((e.target as HTMLElement).closest("#profile-contact-close") || e.target === modal) {
				modal.classList.add("hidden");
				modal.classList.remove("flex");
				modal.setAttribute("aria-hidden", "true");
			}
		});
		const copyBtn = document.getElementById("profile-contact-copy");
		if (copyBtn) {
			copyBtn.addEventListener("click", () => {
				navigator.clipboard
					.writeText(currentValue)
					.then(() => {
						copyBtn.textContent = "已复制";
						setTimeout(() => {
							copyBtn.textContent = "复制号码";
						}, 1500);
					})
					.catch(() => {});
			});
		}
	}
</script>
