---
import { url } from "@/utils/url-utils";

interface Props {
	config: {
		enable: boolean;
		model:
			| {
					path: string;
					name?: string;
					motions?: { label: string; group: string }[];
					systemPrompt?: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }
			| {
					path: string;
					name?: string;
					motions?: { label: string; group: string }[];
					systemPrompt?: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }[];
		position?: "bottom-left" | "bottom-right";
		menus?: { items?: { label: string; action: string }[] };
		tips?: {
			enable?: boolean;
			welcomeMessage?: string[];
			messages?: string[];
			duration?: number;
			interval?: number;
		};
		responsive?: { hideOnMobile?: boolean; mobileBreakpoint?: number };
		chat?: {
			enable: boolean;
			apiEndpoint: string;
			apiKey?: string;
			model: string;
			systemPrompt?: string;
			temperature?: number;
			maxTokens?: number;
			stream?: boolean;
			keepContext?: boolean;
			maxContextMessages?: number;
			requestTimeout?: number;
			ui?: {
				panelOpacity?: number;
				panelBlur?: number;
				width?: string;
				title?: string;
				greeting?: string;
				placeholder?: string;
				sendLabel?: string;
				loadingText?: string;
				errorText?: string;
			};
		};
	};
}

const { config } = Astro.props;
const pets = (Array.isArray(config.model) ? config.model : [config.model]).map(
	(model, index) => ({
		path: /^https?:\/\//.test(model.path) ? model.path : url(model.path),
		name: model.name || `看板娘 ${index + 1}`,
		motions: model.motions?.length
			? model.motions
			: [{ label: "动一动", group: "idle" }],
		systemPrompt: model.systemPrompt || "",
	}),
);
const models = pets.map((pet) => pet.path);
const tips = config.tips ?? {};
const tipsConfig = {
	enable: tips.enable !== false,
	messages: tips.messages ?? [],
	duration: tips.duration ?? 3000,
	interval: tips.interval ?? 6000,
};
const dialog = {
	welcome: tips.welcomeMessage?.[0] ?? "你好呀！我是启明的看板娘~",
	home: "点击这里回到启明的首页！",
	skin: ["想看看我的新衣服吗？", "新衣服真漂亮~"],
	link: "/about/",
	custom: [],
};
const mode = "draggable";
const hiddenOnMobile = config.responsive?.hideOnMobile ?? true;
const mobileBreakpoint = config.responsive?.mobileBreakpoint ?? 768;
const width = 280;
const height = 250;

// ── AI 聊天 ────────────────────────────────────────────────
// 请求发往自建的服务端代理（见 config.chat.apiEndpoint），
// API Key 由代理持有，前端不接触、也不会出现在构建产物里。
const chatUi = config.chat?.ui ?? {};
const chatEnabled = Boolean(config.chat?.enable);
const chatOptions = chatEnabled
	? {
			enable: true,
			apiEndpoint: config.chat?.apiEndpoint ?? "",
			apiKey: config.chat?.apiKey ?? "",
			model: config.chat?.model ?? "",
			systemPrompt: config.chat?.systemPrompt ?? "",
			temperature: config.chat?.temperature ?? 0.8,
			maxTokens: config.chat?.maxTokens ?? 800,
			stream: config.chat?.stream ?? true,
			keepContext: config.chat?.keepContext ?? true,
			maxContextMessages: config.chat?.maxContextMessages ?? 6,
			requestTimeout: config.chat?.requestTimeout ?? 60000,
			ui: {
				panelOpacity: chatUi.panelOpacity ?? 0,
				panelBlur: chatUi.panelBlur ?? 10,
				width: chatUi.width ?? "19rem",
				title: chatUi.title ?? "和看板娘聊聊",
				greeting: chatUi.greeting ?? "你好呀！有什么想聊的都可以和我说～",
				placeholder: chatUi.placeholder ?? "说点什么…",
				sendLabel: chatUi.sendLabel ?? "发送",
				loadingText: chatUi.loadingText ?? "正在思考…",
				errorText: chatUi.errorText ?? "呜…连接不上大脑了，待会儿再试试？",
			},
		}
	: null;
---

{config.enable && (
	<div class={`pio-container ${config.position === "bottom-right" ? "right" : "left"}`}>
		<div class="pio-action" aria-label="看板娘操作"></div>
		<canvas id="pio" width={width} height={height} aria-label="启明的 Live2D 看板娘"></canvas>
		{chatEnabled && chatOptions && (
			<div
				class="pio-chat"
				id="pio-chat"
				role="dialog"
				aria-label={chatOptions.ui.title}
				aria-hidden="true"
				style={`--pio-chat-alpha:${chatOptions.ui.panelOpacity};--pio-chat-blur:${chatOptions.ui.panelBlur}px;--pio-chat-width:${chatOptions.ui.width};`}
			>
				<div class="pio-chat-head">
					<span class="pio-chat-title">{chatOptions.ui.title}</span>
					<button type="button" class="pio-chat-close" id="pio-chat-close" aria-label="关闭聊天">✕</button>
				</div>
				<div class="pio-chat-log" id="pio-chat-log" role="log" aria-live="polite"></div>
				<form class="pio-chat-form" id="pio-chat-form">
					<textarea
						class="pio-chat-input"
						id="pio-chat-input"
						rows="1"
						maxlength="1000"
						placeholder={chatOptions.ui.placeholder}></textarea>
					<button type="submit" class="pio-chat-send" id="pio-chat-send">
						{chatOptions.ui.sendLabel}
					</button>
				</form>
			</div>
		)}
	</div>
)}

{config.enable && (
	<script is:inline define:vars={{ models, pets, tipsConfig, dialog, mode, hiddenOnMobile, mobileBreakpoint, chatOptions }}>
		(() => {
			const options = {
				mode,
				hidden: hiddenOnMobile,
				content: dialog,
				model: models,
			};

			// 当前宠物下标：与 pio.js 写入 localStorage 的选择保持一致，
			// 切换宠物后聊天会改用该宠物的人格（若配置了专属 systemPrompt）
			let activePet = 0;
			try {
				const saved = parseInt(
					window.localStorage.getItem("qiming-pio-model"),
					10,
				);
				if (Number.isInteger(saved) && saved >= 0 && saved < pets.length) {
					activePet = saved;
				}
			} catch (error) {}
			const currentSystemPrompt = () => pets[activePet]?.systemPrompt || "";

			// 聊天面板与宠物/动作面板互斥展示，互相留一个关闭钩子
			let closeChatPanel = null;
			let closePetPanel = null;
			const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
			const loadScript = (src, id) =>
				new Promise((resolve, reject) => {
					const existing = document.getElementById(id);
					if (existing) {
						resolve();
						return;
					}
					const script = document.createElement("script");
					script.id = id;
					script.src = src;
					script.onload = resolve;
					script.onerror = reject;
					document.head.appendChild(script);
				});

			// 点击看板娘弹出 AI 聊天框。
			// 聊天记录只存在内存里：关闭面板即清空，刷新即清空，不写任何 localStorage。
			const initChat = () => {
				const cfg = chatOptions;
				if (!cfg || !cfg.enable) return;
				if (window.__qimingPioChatReady) return;

				const container = document.querySelector(".pio-container");
				const canvas = document.getElementById("pio");
				const panel = document.getElementById("pio-chat");
				const log = document.getElementById("pio-chat-log");
				const form = document.getElementById("pio-chat-form");
				const input = document.getElementById("pio-chat-input");
				const sendBtn = document.getElementById("pio-chat-send");
				const closeBtn = document.getElementById("pio-chat-close");
				if (!container || !canvas || !panel || !log || !form || !input || !sendBtn) return;
				window.__qimingPioChatReady = true;

				/** state.messages 仅存活于本次页面，任何地方都不落盘 */
				const state = { messages: [], open: false, busy: false, controller: null };

				// 面板上的按下必须止住冒泡：pio 的拖拽是绑在 .pio-container 的 onmousedown 上的，
				// 否则在输入框里选词会把看板娘拖走。
				panel.addEventListener("mousedown", (e) => e.stopPropagation());

				const scrollToEnd = () => {
					log.scrollTop = log.scrollHeight;
				};

				const addBubble = (role, text) => {
					const wrap = document.createElement("div");
					wrap.className = "pio-chat-msg pio-chat-" + role;
					const textEl = document.createElement("div");
					textEl.className = "pio-chat-text";
					textEl.textContent = text;
					wrap.appendChild(textEl);
					log.appendChild(wrap);
					scrollToEnd();
					return textEl;
				};

				const setBusy = (busy) => {
					state.busy = busy;
					sendBtn.disabled = busy;
					panel.classList.toggle("is-busy", busy);
				};

				const clearChat = () => {
					state.messages = [];
					log.textContent = "";
				};

				const openChat = () => {
					if (state.open) {
						input.focus();
						return;
					}
					state.open = true;
					clearChat();
					addBubble("assistant", cfg.ui.greeting);
					panel.classList.add("active");
					panel.setAttribute("aria-hidden", "false");
					setTimeout(() => input.focus(), 60);
				};

				const closeChat = () => {
					if (!state.open) return;
					state.open = false;
					state.controller && state.controller.abort();
					state.controller = null;
					panel.classList.remove("active");
					panel.setAttribute("aria-hidden", "true");
					setBusy(false);
					clearChat();
				};
				closeChatPanel = closeChat;

				// 组装上行消息：system + 最近几轮 + 本轮
				const buildMessages = (userText) => {
					const out = [];
					// 当前宠物配置了专属人格时优先使用（比如雪初音）
					const persona = currentSystemPrompt() || cfg.systemPrompt;
					if (persona) {
						out.push({ role: "system", content: persona });
					}
					if (cfg.keepContext) {
						const history = state.messages.slice(0, -1);
						const limit = Math.max(0, cfg.maxContextMessages);
						for (const item of history.slice(-limit)) {
							out.push({ role: item.role, content: item.content });
						}
					}
					out.push({ role: "user", content: userText });
					return out;
				};

				const send = async () => {
					if (state.busy) return;
					const text = input.value.trim();
					if (!text) return;
					if (!cfg.apiEndpoint) {
						addBubble("assistant", "还没有配置对话接口地址呢，去 pioConfig.ts 里填一下吧～");
						return;
					}

					state.messages.push({ role: "user", content: text });
					addBubble("user", text);
					input.value = "";
					const replyEl = addBubble("assistant", cfg.ui.loadingText);
					replyEl.classList.add("is-loading");
					setBusy(true);

					const controller = new AbortController();
					state.controller = controller;
					const timer = setTimeout(() => controller.abort(), cfg.requestTimeout);

					// 面板一旦关闭，后面的流式回调一律不再碰 DOM
					let full = "";
					const write = (chunk, replace) => {
						if (!state.open) return;
						full = replace ? chunk : full + chunk;
						replyEl.classList.remove("is-loading");
						replyEl.textContent = full;
						scrollToEnd();
					};

					try {
						const response = await fetch(cfg.apiEndpoint, {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								...(cfg.apiKey ? { Authorization: "Bearer " + cfg.apiKey } : {}),
							},
							body: JSON.stringify({
								model: cfg.model,
								messages: buildMessages(text),
								temperature: cfg.temperature,
								max_tokens: cfg.maxTokens,
								stream: Boolean(cfg.stream),
							}),
							signal: controller.signal,
						});

						if (!response.ok) {
							const detail = await response.text().catch(() => "");
							throw new Error(
								"HTTP " + response.status + (detail ? " " + detail.slice(0, 200) : ""),
							);
						}

						if (cfg.stream && response.body) {
							const reader = response.body.getReader();
							const decoder = new TextDecoder();
							let buffer = "";
							while (true) {
								const { done, value } = await reader.read();
								if (done) break;
								buffer += decoder.decode(value, { stream: true });
								const lines = buffer.split("\n");
								buffer = lines.pop() ?? "";
								for (const line of lines) {
									const trimmed = line.trim();
									if (!trimmed.startsWith("data:")) continue;
									const payload = trimmed.slice(5).trim();
									if (!payload || payload === "[DONE]") continue;
									let chunk;
									try {
										chunk = JSON.parse(payload);
									} catch {
										continue;
									}
									const delta = chunk?.choices?.[0]?.delta?.content;
									if (typeof delta === "string" && delta) write(delta, false);
								}
							}
						} else {
							const json = await response.json();
							const content = json?.choices?.[0]?.message?.content;
							write(typeof content === "string" && content ? content : cfg.ui.errorText, true);
						}

						if (!full) write(cfg.ui.errorText, true);
						if (state.open) {
							state.messages.push({ role: "assistant", content: full || cfg.ui.errorText });
						}
					} catch (error) {
						// 用户关闭面板或超时触发的 abort，静默处理
						if (error && error.name === "AbortError") return;
						console.error("看板娘聊天请求失败：", error);
						write(cfg.ui.errorText, true);
					} finally {
						clearTimeout(timer);
						if (state.controller === controller) state.controller = null;
						if (state.open) setBusy(false);
					}
				};

				// 区分「拖拽」和「点击」：拖过看板娘就不该弹聊天框
				let armed = false;
				let dragging = false;
				let pressX = 0;
				let pressY = 0;
				container.addEventListener(
					"mousedown",
					(e) => {
						armed = true;
						dragging = false;
						pressX = e.clientX;
						pressY = e.clientY;
					},
					true,
				);
				document.addEventListener(
					"mousemove",
					(e) => {
						if (!armed) return;
						if (Math.abs(e.clientX - pressX) > 5 || Math.abs(e.clientY - pressY) > 5) {
							dragging = true;
						}
					},
					true,
				);
				document.addEventListener("mouseup", () => {
					armed = false;
				}, true);

				canvas.addEventListener("click", () => {
					const wasDrag = dragging;
					dragging = false;
					if (wasDrag) return;
					closePetPanel && closePetPanel();
					if (state.open) {
						closeChat();
					} else {
						openChat();
					}
				});

				input.addEventListener("keydown", (e) => {
					if (e.key === "Enter" && !e.shiftKey) {
						e.preventDefault();
						send();
					}
				});
				form.addEventListener("submit", (e) => {
					e.preventDefault();
					send();
				});
				closeBtn.addEventListener("click", closeChat);

				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && state.open) closeChat();
				});
				document.addEventListener("click", (e) => {
					if (state.open && !container.contains(e.target)) closeChat();
				});
			};

			// ── 宠物切换 + 动作面板 ──────────────────────────────
			// 面板挂在 .pio-container 里（Swup 容器之外，切页不重建）。
			// 切换调用 pio 实例的 switchModel（会重载模型并写 localStorage）；
			// 动作调用 l2d.js 暴露的 __l2dPlayMotion 按动作组随机播放一个动作。
			const initPets = () => {
				const container = document.querySelector(".pio-container");
				const menu = document.querySelector(".pio-container .pio-action");
				if (!container || !menu || !window.__qimingPio) return;

				const pio = window.__qimingPio;

				const panel = document.createElement("div");
				panel.className = "pio-panel";
				panel.setAttribute("aria-hidden", "true");
				container.appendChild(panel);

				// 面板上的按下必须止住冒泡，避免触发看板娘拖拽
				panel.addEventListener("mousedown", (e) => e.stopPropagation());

				let mode = null; // "pet"（切换宠物）| "motion"（动作）| null

				// 动作播完配一句气泡反应，让宠物看起来「有回应」
				const reactions = {
					idle: ["嗯！精神满满！", "嗨嗨～今天也要加油哦！"],
					flick_head: ["好舒服～再摸摸嘛", "嘿嘿，最喜欢摸摸头了"],
					tap_body: ["干嘛戳我呀！", "再戳就要生气了哦！"],
					sleepy: ["Zzz…", "好困呀…让我眯一会儿…"],
				};

				const closePanel = () => {
					mode = null;
					panel.classList.remove("active");
					panel.setAttribute("aria-hidden", "true");
				};
				closePetPanel = closePanel;

				const render = () => {
					panel.textContent = "";
					if (mode === "pet") {
						pets.forEach((pet, index) => {
							const btn = document.createElement("button");
							btn.type = "button";
							btn.className =
								"pio-panel-item" + (index === activePet ? " is-active" : "");
							btn.textContent = pet.name;
							btn.addEventListener("click", () => {
								if (index !== activePet) {
									activePet = index;
									pio.switchModel(index);
									pio.message("我是" + pet.name + "，请多指教～");
								}
								closePanel();
							});
							panel.appendChild(btn);
						});
					} else if (mode === "motion") {
						pets[activePet].motions.forEach((motion) => {
							const btn = document.createElement("button");
							btn.type = "button";
							btn.className = "pio-panel-item";
							btn.textContent = motion.label;
							btn.addEventListener("click", () => {
								if (window.__l2dPlayMotion) {
									window.__l2dPlayMotion(motion.group);
								}
								pio.message(pick(reactions[motion.group] || ["嗨起来～"]));
								closePanel();
							});
							panel.appendChild(btn);
						});
					}
				};

				const openPanel = (next) => {
					// 与聊天面板互斥：打开任意一个先收起另一个
					closeChatPanel && closeChatPanel();
					mode = mode === next ? null : next;
					if (mode) {
						render();
						panel.classList.add("active");
						panel.setAttribute("aria-hidden", "false");
					} else {
						closePanel();
					}
				};

				const addRailButton = (cls, tip, onClick) => {
					const btn = document.createElement("span");
					btn.className = cls;
					btn.title = tip;
					btn.setAttribute("role", "button");
					btn.setAttribute("aria-label", tip);
					btn.addEventListener("click", onClick);
					btn.addEventListener("mouseover", () => pio.message(tip));
					// 插到「关于」按钮前面，让宠物相关的按钮靠在一起
					menu.insertBefore(btn, menu.querySelector(".pio-info"));
				};

				if (pets.length > 1) {
					addRailButton("pio-pet", "切换宠物", () => openPanel("pet"));
					// pio.js 自带的换装按钮也弹出同一个面板（而不是盲切下一只）
					options.events = { onSwitchPet: () => openPanel("pet") };
				}
				addRailButton("pio-motion", "看动作", () => openPanel("motion"));

				document.addEventListener("click", (e) => {
					if (mode && !container.contains(e.target)) closePanel();
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && mode) closePanel();
				});

				// 待机随机气泡：让宠物在没人理的时候也会说话
				if (tipsConfig.enable && tipsConfig.messages.length) {
					window.setInterval(() => {
						if (document.visibilityState !== "visible" || mode) return;
						pio.message(pick(tipsConfig.messages), {
							time: tipsConfig.duration,
						});
					}, Math.max(4000, tipsConfig.interval));
				}
			};

			const init = () => {
				if (window.__qimingPioInitialized || !document.getElementById("pio")) return;
				if (hiddenOnMobile && window.innerWidth <= mobileBreakpoint) {
					const body = document.querySelector(".pio-container");
					if (body) body.style.display = "none";
					return;
				}
				if (typeof window.Paul_Pio !== "function") return;
				window.__qimingPioInitialized = true;
				window.__qimingPio = new window.Paul_Pio(options);
				initChat();
				initPets();
			};

			// l2d.js / pio.js 是本站改过的版本，?v=2 用来打破老访客的浏览器缓存
			const start = () =>
				loadScript("/pio/static/l2d.js?v=2", "qiming-pio-l2d")
					.then(() => loadScript("/pio/static/pio.js?v=2", "qiming-pio-main"))
					.then(init)
					.catch((error) => {
						window.__qimingPioInitialized = false;
						console.error("Pio Live2D 初始化失败：", error);
					});

			// 等首屏资源（壁纸、文章封面）下载完再拉看板娘的脚本和模型，
			// 避免抢同一根带宽管子；load 迟迟不触发（被第三方脚本拖住）时 5 秒兜底
			let booted = false;
			const boot = () => {
				if (booted) return;
				booted = true;
				const idle =
					window.requestIdleCallback ||
					((cb) => window.setTimeout(cb, 200));
				idle(() => start());
			};
			window.addEventListener("load", boot, { once: true });
			window.setTimeout(boot, 5000);
		})();
	</script>
)}

<style is:global>
	/* ── 看板娘 AI 聊天面板 ───────────────────────────────
	   所有选择器都以 .pio-chat 前缀命名，不会影响站内其他元素。
	   面板背景默认全透明（--pio-chat-alpha: 0），靠 backdrop-filter 模糊保证文字可读。 */
	.pio-chat {
		position: absolute;
		left: 1em;
		bottom: calc(100% - 1.5em);
